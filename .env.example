# Copy to .env (done automatically by make) and fill in what your model needs.
# .env is gitignored. Never commit real keys.
LLM_PROVIDER=openai          # openai | anthropic | ollama | other
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=
